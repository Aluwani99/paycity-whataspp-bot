# --- Meta WhatsApp Cloud API (only needed for real WhatsApp; not for the browser tester) ---
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
VERIFY_TOKEN=paycity-verify-123
APP_SECRET=
GRAPH_API_VERSION=v23.0
PORT=3001

# --- payCity data source ---
# mock = built-in sample data for demos | http = a real, authorised payCity API (see README)
PAYCITY_PROVIDER=mock
PAYCITY_API_URL=
PAYCITY_API_KEY=

# false = show only masked notice numbers in ID/BRN/TRN search results (recommended)
SHOW_FULL_FINE_DETAILS=false
